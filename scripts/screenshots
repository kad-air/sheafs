#!/usr/bin/env bash
# App Store screenshots on an iPhone Duo simulator, every pose headless: cover and inner display,
# portrait and landscape, flat and tabletop. Builds the app, installs it fresh on its own simulator
# (created if missing), imports public-domain books from Standard Ebooks (CC0 text and covers, cached),
# then for each shot sets the fold (`hinge`) and the device orientation (`hinge orient`), launches with
# the screenshot launch arguments and saves the lit display. Fails loudly when a shot is not one of App
# Store Connect's iPhone Duo sizes for its display (cover 1398×2034 / 2034×1398, inner 2853×2007 /
# 2007×2853, Apple's screenshot specifications), the hinge reads back wrong, the reader's `[layout]`
# line shows the wrong pose, a `-SheafsGoTo` target is missing, or a shot is blank.
#   SIM="Sheafs Shots" (default; created and booted if missing)
#   OUT=/tmp/sheafs-screenshots (simctl cannot write screenshots to some external volumes)
#   DERIVED_DATA=/tmp/sheafs-derived (builds there, incrementally)
#   NO_BUILD=1 reuses the last build in DERIVED_DATA
set -euo pipefail
cd "$(dirname "$0")/.."
fail() { echo "SCREENSHOTS FAILED: $*" >&2; exit 1; }
SIM=${SIM:-Sheafs Shots}
OUT=${OUT:-/tmp/sheafs-screenshots}
DD=${DERIVED_DATA:-/tmp/sheafs-derived}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/sheafs-screenshots
HINGE=scripts/hinge/hinge
WORK=$(mktemp -d)
CONSOLE_PID=""

find_sim() {
  xcrun simctl list devices available -j | python3 -I -c '
import json, sys
for runtime in json.load(sys.stdin)["devices"].values():
    for d in runtime:
        if d["name"] == sys.argv[1]: print(d["udid"]); sys.exit()
' "$SIM"
}
UDID=$(find_sim)
if [[ -z $UDID ]]; then
  RUNTIME=$(xcrun simctl list runtimes -j | python3 -I -c '
import json, sys
ios = [r for r in json.load(sys.stdin)["runtimes"] if r["platform"] == "iOS" and r["isAvailable"]
       and any(t["identifier"].endswith("iPhone-Duo") for t in r.get("supportedDeviceTypes", []))]
print(ios[-1]["identifier"] if ios else "")')
  [[ -n $RUNTIME ]] || fail "no iOS runtime with the iPhone Duo"
  UDID=$(xcrun simctl create "$SIM" com.apple.CoreSimulator.SimDeviceType.iPhone-Duo "$RUNTIME")
  echo "created simulator \"$SIM\" $UDID"
fi
xcrun simctl boot "$UDID" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$UDID" -b >/dev/null

ORIGINAL=$(xcrun simctl ui "$UDID" appearance)
cleanup() {
  [[ -n $CONSOLE_PID ]] && kill "$CONSOLE_PID" >/dev/null 2>&1 || true
  xcrun simctl ui "$UDID" appearance "$ORIGINAL" >/dev/null 2>&1 || true
  xcrun simctl status_bar "$UDID" clear >/dev/null 2>&1 || true
  rm -rf "$WORK"
}
trap cleanup EXIT

# Public-domain books, each download in its own folder.
BOOKS=(jane-austen/pride-and-prejudice herman-melville/moby-dick mary-shelley/frankenstein
  f-scott-fitzgerald/the-great-gatsby bram-stoker/dracula charlotte-bronte/jane-eyre
  arthur-conan-doyle/the-adventures-of-sherlock-holmes louisa-may-alcott/little-women
  emily-bronte/wuthering-heights oscar-wilde/the-picture-of-dorian-gray)
for slug in "${BOOKS[@]}"; do
  file=${slug//\//_}.epub
  dir=$CACHE/${slug##*/}
  [[ -s $dir/$file ]] && continue
  mkdir -p "$dir"
  curl -fsSL -o "$dir/$file.part" "https://standardebooks.org/ebooks/$slug/downloads/$file?source=download" \
    || fail "download $slug"
  [[ $(head -c 2 "$dir/$file.part") == PK ]] || fail "$slug did not download as an EPUB"
  mv "$dir/$file.part" "$dir/$file"
done

if [[ -z ${NO_BUILD:-} ]]; then
  [[ -f Config/Signing.xcconfig ]] || cp Config/Signing.example.xcconfig Config/Signing.xcconfig
  xcodegen generate --quiet
  xcodebuild -project Sheafs.xcodeproj -scheme Sheafs -destination "platform=iOS Simulator,id=$UDID" \
    -derivedDataPath "$DD" -quiet build >"$WORK/build.log" 2>&1 || { tail -n 30 "$WORK/build.log" >&2; fail "build"; }
fi
APP=$DD/Build/Products/Debug-iphonesimulator/Sheafs.app
[[ -d $APP ]] || fail "no app at $APP"

# A fresh install: empty library, default reader settings (theme Automatic, so Light = Paper).
xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
xcrun simctl uninstall "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
xcrun simctl install "$UDID" "$APP"
xcrun simctl ui "$UDID" appearance light
xcrun simctl status_bar "$UDID" override --time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 \
  --cellularMode active --cellularBars 4 --batteryState charged --batteryLevel 100
DATA=$(xcrun simctl get_app_container "$UDID" io.sheafs.reader data)
mkdir -p "$DATA/Documents"
for slug in "${BOOKS[@]}"; do cp "$CACHE/${slug##*/}/${slug//\//_}.epub" "$DATA/Documents/"; done
"$HINGE" -d "$UDID" orient portrait
"$HINGE" -d "$UDID" 180
xcrun simctl launch "$UDID" io.sheafs.reader >/dev/null   # imports Documents/
for _ in $(seq 1 60); do
  imported=$( (find "$DATA/Library/Application Support/Books" -name '*.epub' 2>/dev/null || true) | wc -l | tr -d ' ')
  [[ $imported -ge ${#BOOKS[@]} ]] && break
  sleep 1
done
[[ $imported -ge ${#BOOKS[@]} ]] || fail "only $imported of ${#BOOKS[@]} books imported"
sleep 3   # covers render

# The pixel checks: the size App Store Connect accepts for the display, and not a blank frame.
inspect() {  # inspect <png> → "<width> <height> <ink: per mille of 10 000 samples off the page colour>"
  sips -s format bmp "$1" --out "$WORK/shot.bmp" >/dev/null
  python3 -I - "$WORK/shot.bmp" <<'PY'
import struct, sys
data = open(sys.argv[1], "rb").read()
offset, = struct.unpack_from("<I", data, 10)
width, height = struct.unpack_from("<ii", data, 18)
step = struct.unpack_from("<H", data, 28)[0] // 8
row = (width * step + 3) & ~3
h = abs(height)
samples = [data[offset + (y * h // 100) * row + (x * width // 100) * step:][:3] for x in range(100) for y in range(100)]
page = max(set(samples), key=samples.count)
ink = sum(1 for s in samples if sum(abs(a - b) for a, b in zip(s, page)) > 60)
print(width, h, ink * 1000 // len(samples))
PY
}

app_store_size() {  # macOS ships bash 3.2: no associative arrays
  case $1 in
    cover-portrait) echo "1398 2034" ;; cover-landscape) echo "2034 1398" ;;
    inner-portrait) echo "2007 2853" ;; inner-landscape) echo "2853 2007" ;;
  esac
}

# shot <file> <cover|inner> <device orientation> <hinge°> <expected layout|-> [launch arguments…]
# The expected layout is a regex the reader's last `[layout]` line must match ("-" for the library).
shot() {
  local file=$1 display=$2 orient=$3 angle=$4 layout=$5
  shift 5
  echo "• $file"
  xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
  [[ -n $CONSOLE_PID ]] && { kill "$CONSOLE_PID" >/dev/null 2>&1 || true; CONSOLE_PID=""; }
  "$HINGE" -d "$UDID" orient "$orient"
  "$HINGE" -d "$UDID" "$angle"
  sleep 2
  local measured
  measured=$("$HINGE" -d "$UDID" get) || fail "$file: cannot read the hinge back"
  python3 -I -c 'import sys; sys.exit(abs(float(sys.argv[1]) - float(sys.argv[2])) > 1)' "$measured" "$angle" \
    || fail "$file: hinge reads $measured°, set $angle°"
  : >"$WORK/console.log"
  xcrun simctl launch --console-pty "$UDID" io.sheafs.reader "$@" >"$WORK/console.log" 2>&1 &
  CONSOLE_PID=$!
  if [[ $layout == - ]]; then
    sleep 6
  else
    for _ in $(seq 1 30); do grep -q '^\[layout\]' "$WORK/console.log" && break; sleep 1; done
    sleep "${SETTLE:-5}"
    grep -q 'nothing in the contents matches' "$WORK/console.log" && fail "$file: $(grep '\[goto\]' "$WORK/console.log")"
    local line
    line=$(grep '^\[layout\]' "$WORK/console.log" | tail -1)
    [[ -n $line ]] || fail "$file: the reader logged no [layout] line (did the book open?)"
    [[ $line =~ $layout ]] || fail "$file: layout is not /$layout/: $line"
  fi
  local display_flag=primary-1 png=$OUT/$file
  [[ $display == cover ]] && display_flag=primary
  mkdir -p "$(dirname "$png")"
  xcrun simctl io "$UDID" screenshot --display="$display_flag" "$png" >/dev/null 2>&1 || fail "$file: screenshot"
  local w h ink kind
  read -r w h ink <<<"$(inspect "$png")"
  if ((w > h)); then kind=$display-landscape; else kind=$display-portrait; fi
  [[ "$w $h" == "$(app_store_size "$kind")" ]] \
    || fail "$file: ${w}×${h} is not App Store Connect's $kind size $(app_store_size "$kind")"
  [[ $file == *$kind* ]] || fail "$file: came out $kind (the orientation did not take?)"
  ((ink >= 5)) || fail "$file: looks blank (ink on $ink‰ of it)"
  echo "  ok: ${w}×${h} $kind, ink on $ink‰"
}

rm -rf "$OUT"
SPREAD='pages=\[\([^)]*\), \([^)]*\)\]'             # two pages side by side
TABLETOP='division=Optional\(\(0\.0, [0-9.]+, [0-9.]+, 40\.0\)\) active=true .*pages=\[\([^)]*\)\]'
SINGLE='pages=\[\([^)]*\)\]'
COVER='camera=Optional.*pages=\[\([^)]*\)\]'        # the cover display: one page below the camera

# Libraries first: opening a book reorders them.
shot inner/inner-landscape-1-library.png   inner portrait        180 -
# Early in a book: page numbers of chapters not laid out yet are estimates, and drift further on.
shot inner/inner-landscape-2-spread.png    inner portrait        180 "$SPREAD"  -SheafsOpen Pride -SheafsGoTo 0.05
SETTLE=8 \
shot inner/inner-landscape-3-flip.png      inner portrait        180 "$SPREAD"  -SheafsOpen Pride -SheafsGoTo 0.05 \
  -SheafsFlipAuto forward -SheafsFlipFreeze 0.5 -SheafsFlipGrab 0.9
shot inner/inner-landscape-4-appearance.png inner portrait       180 "$SPREAD"  -SheafsOpen Gatsby -SheafsGoTo II -SheafsAppearance quick
shot inner/inner-portrait-5-tabletop.png   inner landscape-left  95 "$TABLETOP" -SheafsOpen Moby -SheafsGoTo Loomings
shot inner/inner-portrait-6-page.png       inner landscape-left 180 "$SINGLE"   -SheafsOpen Frankenstein -SheafsGoTo "Letter I"
shot cover/cover-portrait-1-library.png    cover portrait          0 -
shot cover/cover-portrait-2-reader.png     cover portrait          0 "$COVER"   -SheafsOpen Moby -SheafsGoTo Loomings
shot cover/cover-landscape-3-reader.png    cover landscape-left    0 "$SINGLE"  -SheafsOpen Pride -SheafsGoTo II
# Night last: the theme is a saved setting.
SETTLE=9 \
shot inner/inner-landscape-7-night.png     inner portrait        180 "$SPREAD"  -SheafsOpen Dracula -SheafsGoTo 0.05 \
  -SheafsThemeSwitch night

xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
"$HINGE" -d "$UDID" orient portrait
echo "SCREENSHOTS OK: $(find "$OUT" -name '*.png' | wc -l | tr -d ' ') in $OUT"
