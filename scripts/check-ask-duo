#!/usr/bin/env bash
# End-to-end check of Ask on the iPhone Duo simulator: BESIDE the book on the inner display (Ask on
# the left of the fold, the book live on the right as the spread's right page), floating on the cover
# display as before, the running conversation in both, and folding / unfolding with Ask up. Opens
# Alice (the fixture) at -SheafsGoTo 0.3 with no saved questions, and fails loudly unless:
#   1. spread   inner display, flat, no Ask: the reference shot and the spread's right page frame.
#   2. beside   -SheafsAsk asks a question: `[ask] presentation beside` with ONE page, the spread's
#               right page frame; pages turn ONE at a time with Ask up (watch commands next, previous:
#               folio X → X+1 → X, the page flip); the answer comes in; and in the PIXELS the right page
#               is the spread's (the text did not move) while the left page is gone under Ask.
#   3. passage  the selection menu's Ask lands beside too, the passage attached; answered, the pane
#               holds both turns, oldest first, in the order the saved history ON DISK has them
#               (Application Support/Ask/<book>.json: the second source, not the view's word).
#   4. fold     Ask up, folded shut: Ask floats on the cover, same position, same conversation;
#               unfolded: beside again, same position and conversation, the right page the spread's.
#   5. taps     a centre tap beside the book brings the bars up and Ask stays; on the cover display
#               it closes Ask, as before (`[ask] closed`).
# Needs Apple Intelligence on this Mac (the simulator answers with it). The simulator can't be tapped
# from a script: taps go through the launch hooks into the recognizers' actions, and the toolbar's Ask
# button (the same `openAsk()` as `-SheafsAskOpen`) is not pressed.
#   SIM="iPhone Duo" (default), DERIVED_DATA=/tmp/sheafs-derived (builds there, incrementally),
#   OUT=/tmp/sheafs-ask-duo (screenshots and consoles, kept), NO_BUILD=1 reuses the last build
set -euo pipefail
cd "$(dirname "$0")/.."
fail() { echo "ASK DUO CHECK FAILED: $*" >&2; exit 1; }
SIM=${SIM:-iPhone Duo}
DD=${DERIVED_DATA:-/tmp/sheafs-derived}
OUT=${OUT:-/tmp/sheafs-ask-duo}
HINGE=scripts/hinge/hinge
EPUB=Packages/SheafsKit/Tests/SheafsKitTests/Fixtures/alice-epub3.epub
AT=0.3
WORK=$(mktemp -d)
CONSOLE_PID=""
mkdir -p "$OUT"

UDID=$(xcrun simctl list devices available -j | python3 -I -c '
import json, sys
name = sys.argv[1]
for runtime in json.load(sys.stdin)["devices"].values():
    for d in runtime:
        if d["name"] == name: print(d["udid"]); sys.exit()
' "$SIM")
[[ -n $UDID ]] || fail "no simulator named \"$SIM\""
xcrun simctl bootstatus "$UDID" -b >/dev/null
cleanup() {
  local status=$?
  [[ -n $CONSOLE_PID ]] && { kill "$CONSOLE_PID" >/dev/null 2>&1 || true; }
  xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
  rm -rf "$WORK"
  exit "$status"
}
trap cleanup EXIT

if [[ -z ${NO_BUILD:-} ]]; then
  [[ -f Config/Signing.xcconfig ]] || cp Config/Signing.example.xcconfig Config/Signing.xcconfig
  xcodegen generate --quiet
  xcodebuild -project Sheafs.xcodeproj -scheme Sheafs -destination "platform=iOS Simulator,id=$UDID" \
    -derivedDataPath "$DD" -quiet build >"$WORK/build.log" 2>&1 || { tail -n 30 "$WORK/build.log" >&2; fail "build"; }
fi
APP="$DD/Build/Products/Debug-iphonesimulator/Sheafs.app"
[[ -d $APP ]] || fail "no build at $APP"
xcrun simctl install "$UDID" "$APP"
xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
DATA=$(xcrun simctl get_app_container "$UDID" io.sheafs.reader data)
SUPPORT="$DATA/Library/Application Support"
mkdir -p "$DATA/Documents"
cp "$EPUB" "$DATA/Documents/"
xcrun simctl launch "$UDID" io.sheafs.reader >/dev/null            # imports Documents/ (dedupes)
for _ in $(seq 1 30); do ls "$SUPPORT/Books/"*.epub >/dev/null 2>&1 && break; sleep 1; done
xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
ls "$SUPPORT/Books/"*.epub >/dev/null 2>&1 || fail "Alice was not imported"
rm -rf "$SUPPORT/Ask"                                              # no saved questions to start with
# Ask About the Book on (off by default, and the selection menu offers Ask only with it on), the rest
# the defaults. The app container's own copy outranks `simctl spawn defaults`, so it goes first.
PREFS="$DATA/Library/Preferences/io.sheafs.reader.plist"
[[ -f $PREFS ]] && { plutil -remove 'reader\.settings\.v1' "$PREFS" >/dev/null 2>&1 || true; }
SETTINGS='{"theme":"system","font":"newYork","fontSize":19,"lineHeight":1.4,"margin":24,"justified":false,"hyphenate":true,"paragraphStyle":"indented","keepScreenAwake":true,"tapToTurn":true,"askEnabled":true}'
xcrun simctl spawn "$UDID" defaults write io.sheafs.reader reader.settings.v1 -data "$(printf '%s' "$SETTINGS" | xxd -p | tr -d '\n')"

finish() {
  xcrun simctl terminate "$UDID" io.sheafs.reader >/dev/null 2>&1 || true
  [[ -n $CONSOLE_PID ]] && { kill "$CONSOLE_PID" >/dev/null 2>&1 || true; }
  CONSOLE_PID=""
}

# launch <name> <args…>: the app with its console in $OUT/<name>-console.log ($LOG).
launch() {
  local name=$1 attempt; shift
  LOG="$OUT/$name-console.log"
  # A launch right after another sometimes never attaches (simctl prints nothing): retried once.
  for attempt in 1 2; do
    : >"$LOG"
    xcrun simctl launch --console-pty "$UDID" io.sheafs.reader -SheafsOpen Alice -SheafsGoTo "$AT" "$@" >"$LOG" 2>&1 &
    CONSOLE_PID=$!
    for _ in $(seq 1 40); do [[ -s $LOG ]] && break; sleep 0.5; done
    [[ -s $LOG ]] && return
    echo "  (simctl launch printed nothing in 20 s, attempt $attempt; relaunching)"
    finish
  done
  fail "$name: the app never printed anything"
}

# wait_for <regex> <seconds> [count]: until the console has `count` (default 1) lines matching.
wait_for() {
  local pattern=$1 seconds=$2 count=${3:-1} n
  for _ in $(seq 1 $((seconds * 2))); do
    n=$(grep -acE "$pattern" "$LOG" || true)
    (( n >= count )) && return 0
    sleep 0.5
  done
  return 1
}

shot() { xcrun simctl io "$UDID" screenshot "$1" "$2" >/dev/null 2>&1 || fail "screenshot $2"; }

# pose <hinge°>: the device upright (inner display = the book), the hinge at that angle.
pose() {
  "$HINGE" -d "$UDID" orient portrait >/dev/null
  "$HINGE" -d "$UDID" "$1" >/dev/null
  sleep 2
}

# changed <a.png> <b.png> <x0 y0 x1 y1 in points>: the share of the rectangle's pixels (every 3rd,
# at 3x) that differ by more than 24 in some channel.
changed() {
  sips -s format bmp "$1" --out "$WORK/a.bmp" >/dev/null
  sips -s format bmp "$2" --out "$WORK/b.bmp" >/dev/null
  python3 -I - "$WORK/a.bmp" "$WORK/b.bmp" "$3" "$4" "$5" "$6" <<'PY'
import struct, sys
def load(path):
    data = open(path, "rb").read()
    offset, = struct.unpack_from("<I", data, 10)
    width, height = struct.unpack_from("<ii", data, 18)
    bpp, = struct.unpack_from("<H", data, 28)
    return data, offset, width, height, bpp // 8, (width * (bpp // 8) + 3) & ~3
a, b = load(sys.argv[1]), load(sys.argv[2])
if a[2:4] != b[2:4]:
    print("size-mismatch"); sys.exit()
data_a, off_a, width, height, step, row = a
data_b, off_b = b[0], b[1]
x0, y0, x1, y1 = (int(float(v) * 3) for v in sys.argv[3:7])
def pixel(data, offset, x, y):
    yy = (height - 1 - y) if height > 0 else y
    i = offset + yy * row + x * step
    return data[i:i + 3]
changed = total = 0
for y in range(max(0, y0), min(abs(height), y1), 3):
    for x in range(max(0, x0), min(width, x1), 3):
        total += 1
        if max(abs(p - q) for p, q in zip(pixel(data_a, off_a, x, y), pixel(data_b, off_b, x, y))) > 24:
            changed += 1
print(f"{changed / max(1, total):.4f}")
PY
}
at_most() { python3 -I -c "import sys; sys.exit(0 if sys.argv[1] != 'size-mismatch' and float(sys.argv[1]) <= float(sys.argv[2]) else 1)" "$1" "$2"; }
at_least() { python3 -I -c "import sys; sys.exit(0 if sys.argv[1] != 'size-mismatch' and float(sys.argv[1]) >= float(sys.argv[2]) else 1)" "$1" "$2"; }

# field <line> <name>: the value after `name=` in an `[ask] presentation` line (up to the next ` x=`).
field() { python3 -I -c '
import re, sys
m = re.search(r"\b" + re.escape(sys.argv[2]) + r"=(.*?)(?= \w+=|$)", sys.argv[1])
print(m.group(1).strip() if m else "")' "$1" "$2"; }

echo "• 1 spread (inner display, flat, no Ask)"
pose 180
launch spread
wait_for '^\[layout\] size=\(951' 60 || fail "spread: no inner-display layout ($LOG)"
sleep 3
shot --display=primary-1 "$OUT/1-spread.png"
LAYOUT=$(grep -a '^\[layout\] size=(951' "$LOG" | tail -1)
RIGHT=$(python3 -I -c '
import re, sys
frames = re.findall(r"\(([-\d.]+), ([-\d.]+), ([-\d.]+), ([-\d.]+)\)", sys.argv[1].split("pages=")[1].split("textInsets")[0])
if len(frames) != 2: sys.exit("not a spread: " + str(frames))
print("(%s, %s, %s, %s)" % frames[1])' "$LAYOUT") || fail "spread: the inner display is not a spread ($LAYOUT)"
read -r RX RY RW RH < <(echo "$RIGHT" | tr -d '(),' )
echo "  right page $RIGHT"
finish

echo "• 2 beside (-SheafsAsk, pages turned with Ask up)"
launch beside -SheafsAsk "Who has Alice met so far?" -SheafsWatchCommands status,next,previous -SheafsWatchCommandGap 3
wait_for '^\[ask\] state: ' 150 || fail "beside: no answer in 150 s ($LOG)"
wait_for '^\[watch\] launch commands done' 30 || fail "beside: the watch commands never finished ($LOG)"
sleep 2
shot --display=primary-1 "$OUT/2-beside.png"
grep -aE '^\[(ask|flip)\]' "$LOG" | grep -v '^\[ask\] source' | cut -c1-220 | sed 's/^/  /'
grep -aq '^\[ask\] availability: available' "$LOG" || fail "beside: the on-device model is not available (Apple Intelligence on this Mac?)"
PRESENT=$(grep -a '^\[ask\] presentation ' "$LOG" | head -1)
[[ $PRESENT == "[ask] presentation beside "* ]] || fail "beside: Ask did not go beside the book: ${PRESENT:-no presentation line}"
[[ $(field "$PRESENT" pages) == "[$RIGHT]" ]] || fail "beside: the book's page is $(field "$PRESENT" pages), not the spread's right page $RIGHT"
grep -aq '^\[ask\] state: done' "$LOG" || fail "beside: $(grep -a '^\[ask\] state:' "$LOG" | head -1)"
grep -aq '^\[ask\] closed' "$LOG" && fail "beside: Ask closed while pages turned"
python3 -I - "$LOG" <<'PY' || fail "beside: pages did not turn one at a time with Ask up ($LOG)"
import re, sys
turns = re.findall(r"^\[flip\] turn (forward|back) folio (\d+) → (\d+)", open(sys.argv[1], errors="replace").read(), re.M)
print("  turns:", turns)
assert len(turns) == 2, turns
(d1, a, b), (d2, c, d) = turns
assert d1 == "forward" and int(b) == int(a) + 1, "forward should be one page"
assert d2 == "back" and int(c) == int(b) and int(d) == int(a), "back should return to the first page"
PY
SAME=$(changed "$OUT/1-spread.png" "$OUT/2-beside.png" "$RX" "$RY" "$(python3 -I -c "print($RX + $RW)")" "$((${RH%.*} - 30))")
GONE=$(changed "$OUT/1-spread.png" "$OUT/2-beside.png" 16 60 430 600)
at_most "$SAME" 0.005 || fail "beside: the right page moved or changed under Ask ($SAME of its pixels; $OUT/1-spread.png vs 2-beside.png)"
at_least "$GONE" 0.05 || fail "beside: the left page is still there, Ask is not on the left ($GONE changed)"
echo "  ok: beside, the right page unchanged ($SAME changed), the left page under Ask ($GONE changed), turns one page at a time"
finish

echo "• 3 passage (the selection menu's Ask) and the running conversation"
launch passage -SheafsSelect 0.5 -SheafsSelectThen ask -SheafsAskSubjectSend YES
wait_for '^\[select\] ask: ' 60 || fail "passage: the selection menu never came up ($LOG)"
grep -aq '^\[select\] ask: offered=true' "$LOG" || fail "passage: the selection menu offers no Ask: $(grep -a '^\[select\] menu' "$LOG")"
wait_for '^\[ask\] state: ' 150 || fail "passage: no answer in 150 s ($LOG)"
wait_for '^\[ask\] thread: 2 turns' 10 || fail "passage: the pane does not hold both turns: $(grep -a '^\[ask\] thread:' "$LOG" | tail -1)"
sleep 2
shot --display=primary-1 "$OUT/3-history.png"
grep -aE '^\[(ask|select)\]' "$LOG" | grep -v '^\[ask\] source' | cut -c1-220 | sed 's/^/  /'
grep -aq '^\[select\] menu: Highlight, Note, Ask' "$LOG" || fail "passage: the selection menu offers no Ask: $(grep -a '^\[select\] menu' "$LOG")"
grep -aq '^\[ask\] subject .* attached=true' "$LOG" || fail "passage: the selection was not attached"
PRESENT=$(grep -a '^\[ask\] presentation ' "$LOG" | head -1)
[[ $PRESENT == "[ask] presentation beside "* ]] || fail "passage: the selection's Ask did not land beside the book: ${PRESENT:-none}"
grep -aq '^\[ask\] state: done' "$LOG" || fail "passage: $(grep -a '^\[ask\] state:' "$LOG" | head -1)"
THREAD=$(grep -a '^\[ask\] thread: ' "$LOG" | tail -1)
python3 -I - "$THREAD" "$SUPPORT/Ask" <<'PY' || fail "passage: the pane's conversation is not the saved history in order"
import glob, json, sys
files = glob.glob(sys.argv[2] + "/*.json")
assert len(files) == 1, files
saved = json.load(open(files[0]))
shown = sys.argv[1].split("oldest first: ", 1)[1].strip().split(" | ")
questions = [e["question"] for e in saved]
print("  on disk:", questions, "| subjects:", [bool(e.get("subject")) for e in saved])
assert shown == questions, (shown, questions)
assert len(saved) == 2 and not saved[0].get("subject") and saved[1].get("subject"), "the second turn should carry the passage"
assert saved[0]["askedAt"] < saved[1]["askedAt"], "oldest first"
PY
BESIDE_AT=$(field "$PRESENT" location)
echo "  ok: two turns, oldest first, as saved; the passage on the second"

echo "• 4 fold shut and open again with Ask up"
"$HINGE" -d "$UDID" 0 >/dev/null
wait_for '^\[ask\] presentation ' 30 2 || fail "fold: no presentation change after folding shut ($LOG)"
sleep 2.5
shot --display=primary "$OUT/4-closed.png"
CLOSED=$(grep -a '^\[ask\] presentation ' "$LOG" | sed -n 2p)
echo "  $CLOSED" | cut -c1-220
[[ $CLOSED == "[ask] presentation floating "* ]] || fail "fold: Ask is not floating on the cover display: $CLOSED"
[[ $(field "$CLOSED" location) == "$BESIDE_AT" ]] || fail "fold: the position moved: $BESIDE_AT → $(field "$CLOSED" location)"
[[ $(field "$CLOSED" turns) == 2 ]] || fail "fold: the conversation changed: $(field "$CLOSED" turns) turns"
grep -aq '^\[ask\] closed' "$LOG" && fail "fold: Ask closed on folding"
"$HINGE" -d "$UDID" 180 >/dev/null
wait_for '^\[ask\] presentation ' 30 3 || fail "fold: no presentation change after unfolding ($LOG)"
sleep 3
shot --display=primary-1 "$OUT/5-reopened.png"
OPENED=$(grep -a '^\[ask\] presentation ' "$LOG" | sed -n 3p)
echo "  $OPENED" | cut -c1-220
[[ $OPENED == "[ask] presentation beside "* ]] || fail "unfold: Ask is not beside the book again: $OPENED"
[[ $(field "$OPENED" pages) == "[$RIGHT]" ]] || fail "unfold: the book's page is $(field "$OPENED" pages), not $RIGHT"
[[ $(field "$OPENED" location) == "$BESIDE_AT" ]] || fail "unfold: the position moved: $BESIDE_AT → $(field "$OPENED" location)"
[[ $(field "$OPENED" turns) == 2 ]] || fail "unfold: the conversation changed: $(field "$OPENED" turns) turns"
SAME=$(changed "$OUT/1-spread.png" "$OUT/5-reopened.png" "$RX" "$RY" "$(python3 -I -c "print($RX + $RW)")" "$((${RH%.*} - 30))")
at_most "$SAME" 0.005 || fail "unfold: the right page is not the spread's ($SAME changed; $OUT/5-reopened.png)"
echo "  ok: floating when shut, beside when open, same position ($BESIDE_AT) and two turns throughout"
finish

echo "• 5 a centre tap: beside, the bars come up and Ask stays; on the cover, Ask closes"
launch beside-tap -SheafsAskOpen 1 -SheafsTapCenter 4
wait_for '^\[chrome\] 2.5 s after the centre tap' 60 || fail "beside-tap: no verdict ($LOG)"
shot --display=primary-1 "$OUT/6-beside-bars.png"
grep -aE '^\[(ask|tap|chrome)\]' "$LOG" | cut -c1-200 | sed 's/^/  /'
grep -aq '^\[ask\] presentation beside' "$LOG" || fail "beside-tap: Ask is not beside the book"
grep -aq '^\[tap\] at .* → center' "$LOG" || fail "beside-tap: the tap was not a centre tap"
grep -aq '^\[ask\] closed' "$LOG" && fail "beside-tap: the centre tap closed Ask beside the book"
grep -aq '^\[chrome\] 2.5 s after the centre tap the bars are UP' "$LOG" || fail "beside-tap: the bars did not come up"
finish
pose 0
launch cover-tap -SheafsAskOpen 1 -SheafsTapCenter 4
wait_for '^\[ask\] thread: ' 60 || fail "cover-tap: Ask never opened ($LOG)"
sleep 1
shot --display=primary "$OUT/7-cover-ask.png"
wait_for '^\[chrome\] 2.5 s after the centre tap' 30 || fail "cover-tap: no verdict ($LOG)"
grep -aE '^\[(ask|tap|chrome)\]' "$LOG" | cut -c1-200 | sed 's/^/  /'
grep -aq '^\[ask\] presentation floating' "$LOG" || fail "cover-tap: Ask is not floating on the cover display"
grep -aq '^\[ask\] thread: 2 turns' "$LOG" || fail "cover-tap: the cover's panel does not hold the conversation"
grep -aq '^\[ask\] closed' "$LOG" || fail "cover-tap: the centre tap did not close Ask on the cover display"
grep -aq '^\[chrome\] 2.5 s after the centre tap the bars are DOWN' "$LOG" || fail "cover-tap: the tap brought the bars up instead of closing Ask"
finish
pose 180
echo "ASK DUO OK (screenshots and consoles in $OUT)"
